const cache = {}

async function make_pixi(canvas) {
  const app = new PIXI.Application()
  await app.init({
    canvas: canvas,
    width: canvas.width,
    height: canvas.height,

    backgroundAlpha: 0,
    useContextAlpha: false,
    antialias: true,
    autoDensity: true,
    resolution: 1,
  })

  app.stage.scale = 48/64
  app.canvas.style.imageRendering = "pixelated"
  app.canvas.style.imageRendering = "crisp-edges"

  return app;
}
